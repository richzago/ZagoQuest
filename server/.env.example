# Development only. Do not commit your real .env or secrets.
NODE_ENV=development
API_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=zagoquest
JWT_SECRET=replace-with-a-strong-random-secret

# Prefer schema migrations with DB_SYNCHRONIZE=false. For a fresh EMPTY test DB only, use
# npm run db:init:test with an explicit, temporary ALLOW_FRESH_TEST_SCHEMA=true flag.
# NEVER use this initializer on a DB containing saves. Schema sync is legacy development opt-in;
# never enable it for a DB whose contents matter.
DB_SYNCHRONIZE=false
DB_LOGGING=false
CHARACTER_NAME=Richard

# Log level for diagnostic verbosity. WARN/ERROR remain visible.
LOG_LEVEL=INFO

# Fase 5 authentication switch: legacy LOCAL Unity only when false.
# In production WS authorization is mandatory; in development opt-in below.
# WS_AUTH_REQUIRED=true

# Optional 240-tick sampling window (~60s at 250ms) with p50/p95/p99/CPU/RSS/queues.
GAME_METRICS_ENABLED=false
