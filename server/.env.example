# Development only. Do not commit your real .env or secrets.
NODE_ENV=development
API_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=zagoquest
JWT_SECRET=replace-with-a-strong-random-secret

# Opt-in development schema sync; forbidden when NODE_ENV=production.
DB_SYNCHRONIZE=false
DB_LOGGING=false
CHARACTER_NAME=Richard

# Log level for diagnostic verbosity. WARN/ERROR remain visible.
LOG_LEVEL=INFO

# Fase 5 authentication switch: legacy LOCAL Unity only when false.
# In production WS authorization is required by authenticated protocol PR.
# WS_AUTH_REQUIRED=true
